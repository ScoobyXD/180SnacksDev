# Set true to enable Airtable sync after normalization.
AIRTABLE_SYNC_ENABLED=false

# Airtable Personal Access Token with data.records:write and schema.bases:read scope.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# Airtable base ID and target table name.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=IRI Test Upload

# If true, script attempts to create AIRTABLE_TABLE_NAME when missing.
# Requires schema.bases:write scope.
AIRTABLE_CREATE_TABLE_IF_MISSING=true
