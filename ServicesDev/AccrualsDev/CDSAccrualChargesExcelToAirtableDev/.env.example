# Turn Airtable write-on-complete on/off.
AIRTABLE_SYNC_ENABLED=true

# Airtable Personal Access Token.
# Recommended scopes:
# - data.records:write
# - schema.bases:read
# - schema.bases:write
AIRTABLE_TOKEN=

# Target table for append writes (required).
AIRTABLE_TABLE_NAME=

# Option A (simple): if you already know the base ID, set it directly.
AIRTABLE_BASE_ID=x

# Option B (smart create/find): leave AIRTABLE_BASE_ID empty and provide workspace+base name.
AIRTABLE_WORKSPACE_ID=x
AIRTABLE_BASE_NAME=x

# Auto-create behavior.
AIRTABLE_CREATE_BASE_IF_MISSING=true
AIRTABLE_CREATE_TABLE_IF_MISSING=true

# Optional: override extract project folder (auto-detected if omitted)
# CDS_EXTRACT_DIR=CDSAccrualChargesExtractDev

# When table exists, auto-add any missing columns.
AIRTABLE_ADD_MISSING_FIELDS=true
