{
  "name": "deacom-extract-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:setup": "node --loader ts-node/esm src/authSetup.ts",
    "record:auth": "node -e \"require('fs').mkdirSync('generated',{recursive:true})\" && playwright codegen --target=playwright-test --output=generated/deacom.codegen.spec.ts --load-storage=playwright/.auth/deacom.json http://192.168.1.7:8081/",
    "download:run": "node --loader ts-node/esm src/downloadFromAuth.ts",
    "typecheck": "tsc --noEmit",
    "pw:install": "playwright install chromium",
    "run": "playwright test --headed"
  },
  "dependencies": {
    "playwright": "^1.59.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.59.0"
  }
}
